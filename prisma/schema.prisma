// Database schema: every table (model) and list of allowed values (enum) in SmartAgri.

// Generate the Prisma JavaScript client
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL connection settings
datasource db {
  provider  = "postgresql"
  // Used by the app (on Supabase: the pooled connection, port 6543)
  url       = env("DATABASE_URL")
  // Used for migrations (on Supabase: the direct connection, port 5432)
  directUrl = env("DIRECT_URL")
}

// ---- Enums (fixed lists of allowed values) ----

enum GardenType {
  outdoor
  greenhouse
  indoor
  hydroponic
}

enum ResourceStatus {
  active
  inactive
  archived
}

enum SoilType {
  loam
  clay
  sandy
  silt
  peat
  potting_mix
}

enum GrowthStage {
  seedling
  stem_cutting
  vegetative
  flowering
  fruiting
  mature
  harvested
}

enum HealthStatus {
  healthy
  at_risk
  diseased
  recovering
  unknown
}

enum DeviceType {
  esp32_node
  dht22
  dht11
  soil_moisture
  rain
  ldr
  water_flow
  solenoid_valve
  camera
}

// Whether a board has been heard from recently
enum DeviceStatus {
  NEVER_SEEN
  ONLINE
  OFFLINE
}

// Kinds of sensor reading
enum Metric {
  soil_moisture
  temperature
  humidity
  rain
  light
  valve_state
  brightness
  height
}

enum Severity {
  low
  medium
  high
  critical
}

enum DiseaseStatus {
  active
  treated
  resolved
}

enum IrrigationMode {
  manual
  scheduled
  automatic
  ai_recommended
}

enum IrrigationStatus {
  on
  off
}

// AUTO = waters by soil moisture, MANUAL = only when the user says
enum PotIrrigationMode {
  AUTO
  MANUAL
}

// Remote actions the app can send to a board
enum DeviceAction {
  RESTART
  RESET_WIFI
  SLEEP
  FACTORY_RESET
}

// Pump commands sent to a board
enum DeviceCommandType {
  PUMP_ON
  PUMP_OFF
}

// Life of a pump command, from waiting to done or failed
enum DeviceCommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  RETRYING
  EXPIRED
  FAILED
  CANCELLED
}

enum NotificationType {
  info
  warning
  alert
  system
}

enum NotificationStatus {
  unread
  read
}

enum TelegramDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Events that trigger a Telegram message
enum TelegramDeliveryEventType {
  PUMP_ACKNOWLEDGED
  PUMP_FAILED
  DISEASE_ANALYSIS_COMPLETED
  DEVICE_OFFLINE
  DEVICE_RECOVERED
}

enum TaskType {
  irrigation
  fertilizer
  pesticide
  inspection
}

enum TaskStatus {
  pending
  done
  skipped
}

// ---- Models (database tables) ----

// A person with a login; owns everything else
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  passwordSalt     String
  refreshTokenHash String? // not used by the current login
  userName         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gardens            Garden[]
  pots               Pot[]
  plants             Plant[]
  devices            Device[]
  readings           Reading[]
  diseaseReports     DiseaseReport[]
  diseasePredictions DiseasePrediction[]
  irrigationEvents   IrrigationEvent[]
  irrigationConfig   IrrigationConfig?
  schedules          Schedule[]
  notifications      Notification[]
  deviceCommands     DeviceCommand[]
  pumpEvents         PumpEvent[]
  telegramDeliveries TelegramDelivery[]
  telegramSettings   TelegramSettings?
  aiSettings         AiSettings?
  alertResolutions   AlertResolution[]
}

// A garden (e.g. rooftop or balcony) that holds pots and devices
model Garden {
  id        String         @id @default(cuid())
  userId    String
  name      String
  type      GardenType     @default(outdoor)
  location  String?
  lat       Float?
  lng       Float?
  status    ResourceStatus @default(active)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pots               Pot[]
  plants             Plant[]
  devices            Device[]
  readings           Reading[]
  irrigationEvents   IrrigationEvent[]
  deviceCommands     DeviceCommand[]
  weatherSnapshots   WeatherSnapshot[]
  pumpEvents         PumpEvent[]
  diseasePredictions DiseasePrediction[]
  alertResolutions   AlertResolution[]

  @@unique([userId, name])
  @@index([userId, status])
}

// A new board waiting to be added to an account (see lib/device-pairing)
model DevicePairing {
  id                 String    @id @default(cuid())
  hardwareId         String    @unique
  secretHash         String // hashed secret that proves it's the same board
  pairingCode        String // 6-digit code shown by the board
  firmware           String?
  failedAttempts     Int       @default(0)
  lastSeenAt         DateTime  @default(now())
  claimedAt          DateTime?
  claimedByUserId    String?
  deviceId           String?
  // Device key kept only until the board collects it (then cleared)
  pendingKey         String?
  keyExpiresAt       DateTime?
  // Set while the app waits for the user to press BOOT on the board
  confirmRequestedAt DateTime?
  requestUserId      String?
  requestGardenId    String?
  requestPotId       String?
  requestName        String?
  createdAt          DateTime  @default(now())

  @@index([claimedAt, lastSeenAt])
}

// A garden alert the user marked resolved (removed once the problem clears)
model AlertResolution {
  id         String   @id @default(cuid())
  userId     String
  gardenId   String
  alertKey   String
  resolvedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  @@unique([gardenId, alertKey])
  @@index([userId])
}

// One pot in a garden, with its watering settings and pump state
model Pot {
  id                       String            @id @default(cuid())
  userId                   String
  gardenId                 String
  // Pot number per user (POT-1, POT-2, ...), set by the server
  number                   Int
  label                    String
  sizeCm                   Float?
  soilType                 SoilType          @default(loam)
  position                 String?
  status                   ResourceStatus    @default(active)
  irrigationMode           PotIrrigationMode @default(AUTO)
  moistureOnThreshold      Float             @default(30) // pump ON below this %
  moistureOffThreshold     Float             @default(50) // pump OFF above this %
  pumpState                IrrigationStatus  @default(off)
  commandSequence          Int               @default(0) // number of the last command sent
  confirmedCommandSequence Int               @default(0) // last one the board confirmed
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden             Garden              @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  plant              Plant?
  readings           Reading[]
  irrigationEvents   IrrigationEvent[]
  deviceCommands     DeviceCommand[]
  diseasePredictions DiseasePrediction[]
  deviceMappings     DevicePotMapping[]
  pumpEvents         PumpEvent[]

  @@unique([gardenId, label])
  @@unique([userId, number])
  @@index([userId, gardenId, status])
}

// The plant growing in a pot (one plant per pot)
model Plant {
  id                String       @id @default(cuid())
  userId            String
  gardenId          String
  potId             String       @unique
  commonName        String
  scientificName    String?
  variety           String?
  plantedAt         DateTime?
  growthStage       GrowthStage  @default(seedling)
  healthStatus      HealthStatus @default(unknown)
  expectedHarvestAt DateTime?
  imageUrls         String[]     @default([])
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden             Garden              @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  pot                Pot                 @relation(fields: [potId], references: [id], onDelete: Cascade)
  threshold          PlantThreshold?
  diseaseReports     DiseaseReport[]
  diseasePredictions DiseasePrediction[]
  tasks              Task[]

  @@index([userId, gardenId, healthStatus])
  @@index([userId, gardenId, potId])
}

// An ESP32 board added to a user's account
model Device {
  id              String        @id @default(cuid())
  userId          String
  // Optional: a board can be placed in a garden later
  gardenId        String?
  hardwareId      String        @unique
  name            String
  type            DeviceType    @default(esp32_node)
  apiKeyHash      String // hashed device key for ingestion auth
  pin             String?
  model           String?
  firmwareVersion String?
  status          DeviceStatus  @default(NEVER_SEEN)
  lastSeenAt      DateTime?
  // Remote action waiting for the board's next poll
  pendingAction   DeviceAction?
  pendingActionAt DateTime?
  // Number of ports (probe + pump) the board reports
  portCount       Int           @default(1)
  // Port count chosen in the app (null = use the board's own)
  desiredPorts    Int?
  // Last report per port: [{ port, moisture, pump }]
  portStatus      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden      Garden?            @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  readings    Reading[]
  commands    DeviceCommand[]
  potMappings DevicePotMapping[]
  pumpEvents  PumpEvent[]

  @@index([userId, gardenId, status])
}

// A pump ON/OFF command for a board, tracked until it's confirmed
model DeviceCommand {
  id                     String              @id @default(cuid())
  userId                 String
  gardenId               String
  deviceId               String
  potId                  String
  command                DeviceCommandType
  status                 DeviceCommandStatus @default(PENDING)
  mode                   PotIrrigationMode
  error                  String?
  createdAt              DateTime            @default(now())
  sentAt                 DateTime?
  processedAt            DateTime?
  acknowledgedAt         DateTime?
  deliveryAcknowledgedAt DateTime?
  executionResultAt      DateTime?
  attemptCount           Int                 @default(0)
  lastAttemptAt          DateTime?
  nextAttemptAt          DateTime            @default(now())
  expiresAt              DateTime
  sequence               Int                 @default(0) // order number per pot (old ones are ignored)
  decisionMoisture       Float? // moisture % when the decision was made
  onThreshold            Float?
  offThreshold           Float?
  pumpEvents             PumpEvent[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pot    Pot    @relation(fields: [potId], references: [id], onDelete: Cascade)

  @@index([deviceId, status, createdAt])
  @@index([userId, potId, createdAt])
}

// Links a board's port to the pot it measures and waters
model DevicePotMapping {
  id            String   @id @default(cuid())
  deviceId      String
  potId         String
  // Which port (1-6) on the board serves this pot
  port          Int      @default(1)
  sensorChannel String?
  createdAt     DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pot    Pot    @relation(fields: [potId], references: [id], onDelete: Cascade)

  @@unique([deviceId, potId])
  @@unique([deviceId, port])
  @@unique([deviceId, sensorChannel])
  @@index([potId])
}

// Saved weather for a garden at one moment
model WeatherSnapshot {
  id              String   @id @default(cuid())
  gardenId        String
  temperature     Float?
  humidity        Float?
  precipitation   Float?
  rainProbability Float?
  windSpeed       Float?
  condition       String?
  uvIndex         Float?
  provider        String
  observedAt      DateTime
  fetchedAt       DateTime @default(now())

  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)

  @@index([gardenId, observedAt])
}

// History of pump changes (on/off) for each pot
model PumpEvent {
  id            String              @id @default(cuid())
  userId        String
  gardenId      String
  potId         String
  deviceId      String
  commandId     String?
  previousState IrrigationStatus
  newState      IrrigationStatus
  source        PotIrrigationMode
  status        DeviceCommandStatus
  failureReason String?
  occurredAt    DateTime            @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden  Garden         @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  pot     Pot            @relation(fields: [potId], references: [id], onDelete: Cascade)
  device  Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  command DeviceCommand? @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([userId, potId, occurredAt])
  @@index([gardenId, occurredAt])
}

// One sensor value (e.g. soil moisture) at one time
model Reading {
  id         String   @id @default(cuid())
  userId     String
  gardenId   String
  potId      String?
  deviceId   String
  hardwareId String
  metric     Metric
  value      Float
  unit       String?
  quality    String?
  recordedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  pot    Pot?   @relation(fields: [potId], references: [id], onDelete: SetNull)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, metric, recordedAt])
  @@index([gardenId, recordedAt])
  @@index([userId, metric, recordedAt])
}

// A disease found on a plant, with symptoms and treatment advice
model DiseaseReport {
  id                      String        @id @default(cuid())
  userId                  String
  plantId                 String?
  cropName                String?
  diseaseName             String
  className               String?
  confidence              Float         @default(0)
  severity                Severity      @default(low)
  symptoms                String[]      @default([])
  treatmentImmediate      String[]      @default([])
  treatmentOrganic        String[]      @default([])
  treatmentChemical       String[]      @default([])
  treatmentPrevention     String[]      @default([])
  recommendation          String?
  imageUrls               String[]      @default([])
  healthScoreContribution Float         @default(100)
  status                  DiseaseStatus @default(active)
  detectedAt              DateTime      @default(now())
  resolvedAt              DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant Plant? @relation(fields: [plantId], references: [id], onDelete: SetNull)

  @@index([userId, status, detectedAt])
  @@index([plantId, detectedAt])
}

// Saved AI result for one leaf photo (never changed after saving)
model DiseasePrediction {
  id               String   @id @default(cuid())
  userId           String
  gardenId         String
  potId            String
  plantId          String
  imageRef         String
  imageMimeType    String
  predictedDisease String
  className        String?
  confidence       Float
  // Extra AI detail (alternatives, unsure flag, ...) shown when reopened
  details          Json?
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden Garden @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  pot    Pot    @relation(fields: [potId], references: [id], onDelete: Cascade)
  plant  Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([userId, plantId, createdAt])
  @@index([userId, gardenId, potId, createdAt])
}

// A record of one watering decision or run
model IrrigationEvent {
  id              String           @id @default(cuid())
  userId          String
  gardenId        String?
  potId           String?
  mode            IrrigationMode   @default(automatic)
  status          IrrigationStatus
  manualOverride  Boolean          @default(false)
  amountMl        Float?
  durationSeconds Int?
  reason          String?
  soilMoisture    Float?
  onThreshold     Float?
  offThreshold    Float?
  decision        String?
  outcome         String?
  startedAt       DateTime         @default(now())
  endedAt         DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  garden Garden? @relation(fields: [gardenId], references: [id], onDelete: SetNull)
  pot    Pot?    @relation(fields: [potId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([gardenId, startedAt])
}

// A user's overall watering settings
model IrrigationConfig {
  id               String           @id @default(cuid())
  userId           String           @unique
  thresholdPercent Float            @default(30)
  manualOverride   Boolean          @default(false)
  currentStatus    IrrigationStatus @default(off)
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Ideal ranges for a plant; used for advice and auto-watering
model PlantThreshold {
  id              String @id @default(cuid())
  plantId         String @unique
  tempDayMin      Float?
  tempDayMax      Float?
  tempNightMin    Float?
  tempNightMax    Float?
  humidityMin     Float?
  humidityMax     Float?
  lightMin        Float?
  lightMax        Float?
  soilMoistureMin Float? @default(30)
  soilMoistureMax Float? @default(70)

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
}

// A timed watering plan (start time, length, days)
model Schedule {
  id              String   @id @default(cuid())
  userId          String
  gardenId        String?
  potId           String?
  startTime       String // "HH:MM"
  durationMinutes Int      @default(15)
  days            String[] @default([])
  enabled         Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An in-app message for the user (read/unread)
model Notification {
  id        String             @id @default(cuid())
  userId    String
  gardenId  String?
  potId     String?
  plantId   String?
  type      NotificationType   @default(info)
  severity  Severity           @default(low)
  title     String
  message   String
  status    NotificationStatus @default(unread)
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

// A Telegram message waiting to be sent, or already sent (outbox)
model TelegramDelivery {
  id                String                    @id @default(cuid())
  userId            String
  eventKey          String                    @unique // stops the same event being sent twice
  eventType         TelegramDeliveryEventType
  eventRef          String
  channel           String                    @default("telegram")
  // Just a label; the real chat ID is never saved here
  destinationRef    String                    @default("configured-default")
  messageText       String
  status            TelegramDeliveryStatus    @default(PENDING)
  attemptCount      Int                       @default(0)
  nextAttemptAt     DateTime                  @default(now())
  lastErrorCode     String?
  providerMessageId String?
  lastAttemptAt     DateTime?
  leaseExpiresAt    DateTime? // a worker is sending it until this time
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  sentAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([userId, createdAt])
}

// A garden task for a plant (water, fertilise, inspect, ...)
model Task {
  id        String     @id @default(cuid())
  plantId   String
  type      TaskType
  dueAt     DateTime?
  status    TaskStatus @default(pending)
  notes     String?
  createdAt DateTime   @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, status])
}

// A user's Telegram bot setup; the bot token is stored encrypted
model TelegramSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  botTokenCipher String
  botUsername    String
  chatId         String?
  chatName       String?
  // Paused: no alerts sent, but the bot stays saved for later
  paused         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Which AI checks leaf photos
enum AiProvider {
  LOCAL
  GEMINI
  GROQ
}

// A user's AI choice; API keys are stored encrypted, never in plain text
model AiSettings {
  userId          String     @id
  provider        AiProvider @default(LOCAL)
  geminiKeySealed String?
  geminiModel     String?
  groqKeySealed   String?
  groqModel       String?
  // If the online AI fails, use the local model instead
  fallbackToLocal Boolean    @default(true)
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
