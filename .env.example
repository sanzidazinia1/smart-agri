# Example settings: copy to .env.development for local use (real values stay out of Git).

# ---- Database (PostgreSQL) ----
# Local Postgres: both URLs are the same
DATABASE_URL="postgresql://USER@localhost:5432/smartagriai?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/smartagriai?schema=public"
# Supabase: DATABASE_URL = pooler (port 6543), DIRECT_URL = direct (5432); see docs/DEPLOY.md

# ---- Login (NextAuth) ----
# Make one with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"

# ---- AI disease-detection service (FastAPI) ----
# Use 127.0.0.1, not localhost (avoids an IPv6/IPv4 mix-up)
AI_SERVICE_URL="http://127.0.0.1:8001"
# Shared secret, only for a publicly hosted AI service (x-ai-token)
# AI_SERVICE_TOKEN=""

# ---- Garden weather (Open-Meteo, no API key needed) ----
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
# How long a weather result is reused (seconds)
WEATHER_CACHE_TTL_SECONDS="600"
# Save a weather snapshot per garden at most this often (seconds)
WEATHER_SNAPSHOT_INTERVAL_SECONDS="600"

# ---- Garden location search (map picker; defaults to OpenStreetMap Nominatim) ----
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"

# ---- Disease photo storage ----
# Live: Supabase Storage (private bucket, made automatically)
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="server-only secret from Supabase → Project Settings → API Keys"
# SUPABASE_STORAGE_BUCKET="disease-images"
# Local (no Supabase values): photos are saved in this folder
DISEASE_IMAGE_UPLOAD_DIR=".data/disease-predictions"

# ---- Demo seed login (leave out for a random password) ----
# DEMO_PASSWORD=""

# ---- IoT simulator (DEVICE_ID = hardwareId; POT_IDS = pot IDs in its garden) ----
# DEVICE_ID="your-registered-hardware-id"
# DEVICE_KEY="the-one-time-device-registration-key"
# POT_IDS="your-pot-id,another-pot-id"
# API_URL="http://localhost:3000"

# ---- Scheduled Telegram sender ----
# Protects the /api/cron/telegram-deliveries route (not needed locally)
CRON_SECRET=change-me-to-a-random-server-only-value

# ---- Device-offline monitoring: seconds of silence before STALE, then OFFLINE ----
DEVICE_STALE_THRESHOLD_SECONDS=45
DEVICE_OFFLINE_THRESHOLD_SECONDS=90

# ---- Pump command retries and timeouts ----
DEVICE_COMMAND_ACK_TIMEOUT_SECONDS=30
DEVICE_COMMAND_RETRY_INTERVAL_SECONDS=5
DEVICE_COMMAND_MAX_ATTEMPTS=3
DEVICE_COMMAND_MAX_LIFETIME_SECONDS=90
# Safety: pumps switch off after this many seconds without the server
DEVICE_COMMUNICATION_LOSS_FAILSAFE_SECONDS=60
